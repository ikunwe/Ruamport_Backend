NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:4200
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Separate Gmail mail-read OAuth from Supabase social login.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/v1/mail/gmail/callback
# Frontend must implement this route. This is not the Supabase login callback.
GMAIL_FRONTEND_RETURN_URL=http://localhost:4200/mail/return
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key stable and secret. Changing it makes existing connections unreadable.
MAIL_TOKEN_ENCRYPTION_KEY=
# Check the real From address on a Dime email. Comma-separated domains, no @ or wildcard.
DIME_MAIL_SENDER_DOMAINS=dime.co.th

# Finnhub: verify display/news licensing for your intended production use.
# Keep the key only in Backend .env. Never expose it to the browser.
FINNHUB_API_KEY=
# Price TTL while the scheduled US core session is open; closed-session expiry is dynamic.
STOCK_PRICE_CACHE_TTL_SECONDS=900
# Logo URL metadata: 7 days. All market-data endpoints share one request budget.
STOCK_LOGO_CACHE_TTL_SECONDS=604800
STOCK_NEWS_CACHE_TTL_SECONDS=1800
FINNHUB_CALLS_PER_MINUTE=60
# Optional application daily cap; 0 disables our cap, not a promise of provider entitlement.
FINNHUB_CALLS_PER_DAY=0

# SEC Open API: use ONE primary or secondary subscription key, never both to bypass quota.
SEC_API_KEY=
# Yahoo Thai stock prices: no provider API key. Fixed TTL, separate from the US calendar.
THAI_PRICE_CACHE_TTL_SECONDS=900
# NAV can be published later than its valuation date; check periodically instead of freezing all day.
FUND_NAV_CACHE_TTL_SECONDS=3600
# Logo.dev fund/AMC logos. CDN publishable key is safe in image URLs.
LOGO_DEV_PUBLISHABLE_KEY=
# Optional standalone Search API testing only; not used by the holdings logo resolver.
LOGO_DEV_SECRET_KEY=

